DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# Secret de signature des JWT, encodé en base64 (au moins 32 octets) : openssl rand -base64 48
JWT_SECRET=

# Clés des fournisseurs de modèles. Une clé vide désactive le fournisseur.
# Mistral : https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# Gemini : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Ollama Cloud : https://ollama.com/settings/keys
OLLAMA_API_KEY=
